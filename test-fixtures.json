{
  "$comment": [
    "What Surveyor's integration tests take from this repository, at the commit its jar was built",
    "from (./build-surveyor expectations). tests[]: unit-test source roots; expectations[]: the data",
    "files that drive tests (their id field is the test ID); fixtures[]: paths to export by tier",
    "(0 committed and small, 1 nightly, 2 full corpora); downloads[]: fetched at the given tier."
  ],
  "schemaVersion": 1,
  "component": "saffron",
  "tests": [
    "src/test/java"
  ],
  "expectations": [
    {
      "glob": "src/test/resources/corpus-verification/*.json",
      "format": "saffron-corpus-verification",
      "idField": "id",
      "fixture": {
        "field": "imagePath",
        "strip_prefix": "/corpus/",
        "prefix": "test-corpus/"
      }
    },
    {
      "glob": "src/test/resources/ntfs/fixtures/*.json",
      "format": "saffron-ntfs-fixture",
      "idField": "id",
      "fixture": {
        "field": "image",
        "prefix": "src/test/resources/ntfs/fixtures/"
      }
    }
  ],
  "fixtures": [
    {
      "path": "src/test/resources/corpus-verification",
      "tier": 0
    },
    {
      "path": "src/test/resources/ntfs",
      "tier": 0
    },
    {
      "path": "src/test/resources",
      "tier": 1
    },
    {
      "path": "scripts/download-corpus-s3.sh",
      "tier": 0
    }
  ],
  "downloads": [
    {
      "script": "scripts/download-corpus-s3.sh",
      "args": [
        "--mode",
        "small",
        "--corpus-dir",
        "test-corpus"
      ],
      "tier": 2
    }
  ]
}
